# Copy this file to ".env" in the same folder and fill in real values.
# ".env" is git-ignored — never commit real credentials.

# SMTP account used to send password-reset emails.
# Gmail: use an App Password (Google Account > Security > App passwords), not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-sender-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=your-sender-address@gmail.com
SMTP_FROM_NAME=Security2

# "Continue with Google": students use @csucc.edu.ph accounts, administrators personal ones.
# Google Cloud Console > Google Auth Platform > Clients > Web application.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost/security2/php/google_callback.php
